# Kilter environment variables
# Copy to .env and fill in values.
# Never commit .env.

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kilter:kilter@localhost:5432/kilter

# ── OpenAI (for L3 semantic embeddings — text-embedding-3-small) ─────
OPENAI_API_KEY=sk-...

# ── Kilter runtime ───────────────────────────────────────────────────
# Set to 1 to return fixture JSON from all API routes (demo fallback)
KILTER_FIXTURES=0

# Probe runner settings
KILTER_PROBE_N_SAMPLES=10          # samples per probeset per run
KILTER_PROBE_BASELINE_CYCLES=3     # cycles to collect before baseline is established
KILTER_PROBE_DEFAULT_RPS=0.2       # max requests per second per server (hard cap)

# Scheduler: run a probe sweep every N minutes
KILTER_SCHEDULER_INTERVAL_MINUTES=20

# API
KILTER_CORS_ORIGINS=http://localhost:5173,https://kilter.vercel.app

# User agent sent with every probe request — identifies us, includes contact
KILTER_USER_AGENT=Kilter-Probe/0.1 (https://kilter.app; probe@kilter.app)

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
